# Local development only. These values are intentionally non-secret defaults.
NODE_ENV=development
# Desktop Vite development endpoint (production release builds set this explicitly).
VITE_API_URL=http://127.0.0.1:3000
# Optional live Microsoft Store listing used by the public download page.
VITE_MSSTORE_URL=
CORS_ORIGIN=http://127.0.0.1:1420,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

POSTGRES_DB=guilda
POSTGRES_USER=guilda
POSTGRES_PASSWORD=guilda
POSTGRES_PORT=5432
DATABASE_URL=postgresql://guilda:guilda@localhost:5432/guilda

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=guilda-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PORT=9100
S3_CONSOLE_PORT=9101

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_RTC_PORT_START=50000
LIVEKIT_RTC_PORT_END=50010
