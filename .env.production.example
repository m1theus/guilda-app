# Generic production inventory. Keep real values in a secret manager, never in Git.
NODE_ENV=production
PORT=3000

# Public build input for your own deployment.
GUILDA_API_URL=https://api.example.com
VITE_API_URL=https://api.example.com
VITE_MSSTORE_URL=

# Server runtime.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
CORS_ORIGIN=https://app.example.com,tauri://localhost,http://tauri.localhost,https://tauri.localhost
PUBLIC_BASE_URL=https://api.example.com
REFRESH_TOKEN_TTL_SECONDS=2592000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# S3-compatible object storage.
S3_ENDPOINT=https://s3.example.com
S3_BROWSER_ENDPOINT=https://storage.example.com
S3_REGION=us-east-1
S3_BUCKET=guilda-example
S3_ACCESS_KEY=
S3_SECRET_KEY=

# LiveKit/WebRTC media plane.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
