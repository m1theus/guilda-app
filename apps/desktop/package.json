{
  "name": "@guilda/desktop",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "native:build": "tauri build",
    "native:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "native:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "native:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "web:preview": "pnpm build && vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@guilda/types": "workspace:*",
    "@guilda/ui": "workspace:*",
    "@tanstack/react-query": "^5.62.8",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "livekit-client": "^2.7.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
