{
  "name": "@guilda/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./realtime": "./src/realtime/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@guilda/database=../../packages/database/src/index.ts --alias:@guilda/types=../../packages/types/src/index.ts --alias:@guilda/validation=../../packages/validation/src/index.ts --sourcemap --outfile=dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.738.0",
    "@aws-sdk/s3-request-presigner": "^3.738.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.0.1",
    "@fastify/sensible": "^6.0.3",
    "@guilda/database": "workspace:*",
    "@guilda/types": "workspace:*",
    "@guilda/validation": "workspace:*",
    "@prisma/client": "^6.7.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.41.1",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "jose": "^6.0.8",
    "livekit-server-sdk": "^2.9.6",
    "pino": "^9.6.0",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "zod": "^4.6.6"
  }
}
